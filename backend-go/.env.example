# Server
PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL / Neon (supports DATABASE_URL or existing Render Spring env vars)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/trace?sslmode=disable
# SPRING_DATASOURCE_URL=jdbc:postgresql://host/db?sslmode=require
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# Embeddings — Cloudflare Workers AI (@cf/baai/bge-small-en-v1.5, 384 dims)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
PGVECTOR_TABLE=trace_vectors_cf_384

# Chat LLMs — Groq primary + Gemini 2.5 Flash fallback
GROQ_API_KEY=your_groq_api_key
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_CHAT_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,openai/gpt-oss-20b,openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
GROQ_MAX_TOKENS=1024
GOOGLE_GENAI_API_KEY=your_gemini_api_key
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Optional GitHub token (public repos work without one)
GITHUB_TOKEN=
